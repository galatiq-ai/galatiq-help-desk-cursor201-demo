# Optional. You do NOT need a .env file for the workshop.
#
# With these left blank (or no .env at all) scripts/zammad.py uses the local desk in
# data/desk/tickets.json. That is what the follow-along guide uses.
#
# Only if you have your own Zammad help desk and want the same CLI to talk to it:
#   cp .env.example .env   (.env is gitignored; never commit real tokens)
ZAMMAD_URL=
ZAMMAD_API_TOKEN=
# Set to 1 to force the local desk even when the two values above are filled in.
# ZAMMAD_LOCAL=1
